# Ignora tutto nella root tranne le cartelle sorgente e file di documentazione
/*
!/crypto_benchmarks/
!/radio_benchmarks/
!.gitignore
!/README.md

# Cartelle generate automaticamente dai benchmark e dalla build
crypto_benchmarks/build/
crypto_benchmarks/data/
crypto_benchmarks/plots/
crypto_benchmarks/ubuntu22.04_armA72/plots/
crypto_benchmarks/ubuntu22.04_armA72/python/
radio_benchmarks/build/
**/plots/
**/build/
**/.cache/

# File oggetto, librerie statiche e dinamiche, eseguibili
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.so
**/*.dylib
**/*.dll
**/*.exe
**/*.out

# File temporanei di sistema e IDE
.DS_Store
**/.DS_Store
.vscode/
**/.vscode/
.idea/
**/.idea/
__pycache__/
**/__pycache__/
*.pyc
