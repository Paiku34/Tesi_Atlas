# Ignora tutto nella root tranne metriche_librerie e file di documentazione
/*
!/metriche_librerie/
!.gitignore
!/README.md

# Cartelle generate automaticamente dai benchmark e dalla build
metriche_librerie/build/
metriche_librerie/data/
metriche_librerie/plots/
**/build/
**/.cache/

# File oggetto, librerie statiche e dinamiche, eseguibili
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.so
**/*.dylib
**/*.dll
**/*.exe
**/*.out

# File temporanei di sistema e IDE
.DS_Store
**/.DS_Store
.vscode/
**/.vscode/
.idea/
**/.idea/
__pycache__/
**/__pycache__/
*.pyc
